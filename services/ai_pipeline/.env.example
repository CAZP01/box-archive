# Konfigurasi LLM Summarization (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Konfigurasi Speech-to-Text (Faster-Whisper)
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5

# Batas Waktu Pemrosesan & Keandalan (NFR Performance & NFR-08)
MAX_PROCESSING_SECONDS=1800
MAX_RETRIES=3
